{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      // Lets the demo and tests import '@algebrakit/sdk' like external users do, resolved to the local source
      "@algebrakit/sdk": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
